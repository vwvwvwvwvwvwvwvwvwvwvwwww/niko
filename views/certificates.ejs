<%- include('header') %>

<section class="max-w-5xl mx-auto px-4 py-24">
    <div class="text-center mb-16">
        <h1 class="text-6xl font-black text-zinc-900 tracking-tighter mb-4">Дарите <span class="text-emerald-600">эмоции</span></h1>
        <p class="text-zinc-500 max-w-xl mx-auto">Электронный подарочный сертификат Niko — лучший способ поздравить близких и подарить незабываемый активный отдых.</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
        <!-- Preview -->
        <div class="sticky top-24">
            <div id="cert-preview" class="aspect-[1.6/1] bg-gradient-to-br from-zinc-900 to-zinc-800 rounded-[3rem] p-12 text-white relative overflow-hidden shadow-2xl transition-all duration-700">
                <div class="absolute -top-24 -right-24 w-64 h-64 bg-emerald-500/20 rounded-full blur-3xl"></div>
                <div class="absolute -bottom-24 -left-24 w-64 h-64 bg-emerald-500/10 rounded-full blur-3xl"></div>
                
                <div class="relative z-10 flex flex-col h-full justify-between">
                    <div class="flex justify-between items-start">
                        <div>
                            <span class="text-[10px] font-bold uppercase tracking-widest text-emerald-400">Подарочный сертификат</span>
                            <h2 class="text-3xl font-black mt-2">NIKO BASE</h2>
                        </div>
                        <i data-lucide="gift" class="w-10 h-10 text-emerald-500"></i>
                    </div>

                    <div class="space-y-1">
                        <div class="text-5xl font-black"><span id="preview-amount">5 000</span> ₽</div>
                        <div class="text-xs text-zinc-400">На любые услуги базы отдыха</div>
                    </div>

                    <div class="flex justify-between items-end border-t border-white/10 pt-8">
                        <div>
                            <div class="text-[10px] uppercase font-bold text-zinc-500">Для кого:</div>
                            <div class="text-sm font-bold" id="preview-recipient">Счастливчик</div>
                        </div>
                        <div class="text-[10px] font-mono text-zinc-600">CODE: CERT-XXXXXXXXX</div>
                    </div>
                </div>
            </div>
            
            <div class="mt-8 flex gap-4">
                <button onclick="changeCertTheme('zinc')" class="w-8 h-8 rounded-full bg-zinc-800 ring-2 ring-emerald-500"></button>
                <button onclick="changeCertTheme('emerald')" class="w-8 h-8 rounded-full bg-emerald-600"></button>
                <button onclick="changeCertTheme('blue')" class="w-8 h-8 rounded-full bg-blue-600"></button>
            </div>
        </div>

        <!-- Form -->
        <div class="glass p-12 rounded-[3.5rem] border border-zinc-100 shadow-2xl">
            <h3 class="text-2xl font-bold mb-4">Оформление покупки</h3>
            <p class="text-[11px] text-zinc-400 mb-8 leading-relaxed">Внимание: Сертификат будет автоматически привязан к аккаунту получателя. Получатель должен быть зарегистрирован на базе отдыха Niko.</p>
            
            <% if (typeof error !== 'undefined' && error) { %>
                <div class="mb-6 p-4 bg-red-50 border border-red-100 text-red-600 rounded-2xl text-xs animate-shake">
                    <i data-lucide="alert-circle" class="inline w-3 h-3 mr-1"></i>
                    <%= error %>
                </div>
            <% } %>

            <form action="/certificates/buy" method="POST" class="space-y-6">
                <div class="grid grid-cols-2 gap-4">
                    <button type="button" onclick="setAmount(3000)" class="py-4 border-2 border-zinc-100 rounded-2xl hover:border-emerald-500 transition-all font-bold">3 000 ₽</button>
                    <button type="button" onclick="setAmount(5000)" class="py-4 border-2 border-emerald-500 bg-emerald-50/50 rounded-2xl transition-all font-bold">5 000 ₽</button>
                    <button type="button" onclick="setAmount(10000)" class="py-4 border-2 border-zinc-100 rounded-2xl hover:border-emerald-500 transition-all font-bold">10 000 ₽</button>
                    <div class="relative">
                        <input type="number" id="custom-amount" name="amount" value="5000" class="w-full h-full py-4 px-6 border-2 border-zinc-100 rounded-2xl outline-none focus:border-emerald-500 font-bold" placeholder="Своя сумма">
                    </div>
                </div>

                <div class="space-y-4">
                    <div>
                        <label class="block text-xs font-bold uppercase text-zinc-400 mb-2">Email получателя</label>
                        <input type="email" name="recipient_email" required class="w-full px-6 py-4 bg-zinc-50 rounded-2xl border-none outline-none ring-1 ring-zinc-200 focus:ring-emerald-500" placeholder="friend@example.com" id="in-email">
                    </div>
                    <div>
                        <label class="block text-xs font-bold uppercase text-zinc-400 mb-2">Ваше имя</label>
                        <input type="text" name="sender_name" required class="w-full px-6 py-4 bg-zinc-50 rounded-2xl border-none outline-none ring-1 ring-zinc-200 focus:ring-emerald-500" placeholder="Ваше имя">
                    </div>
                    <div>
                        <label class="block text-xs font-bold uppercase text-zinc-400 mb-2">Сообщение</label>
                        <textarea name="message" rows="3" class="w-full px-6 py-4 bg-zinc-50 rounded-2xl border-none outline-none ring-1 ring-zinc-200 focus:ring-emerald-500 resize-none" placeholder="Теплое пожелание..."></textarea>
                    </div>
                </div>

                <% if (user) { %>
                    <button type="submit" class="w-full py-5 bg-emerald-600 text-white rounded-2xl font-bold text-lg hover:bg-emerald-700 transition-all shadow-xl shadow-emerald-100">
                        Оплатить сертификат
                    </button>
                <% } else { %>
                    <div class="p-6 bg-zinc-50 rounded-2xl text-center">
                        <p class="text-sm text-zinc-500 mb-4">Для покупки сертификата необходимо войти в аккаунт</p>
                        <a href="/login" class="inline-block px-8 py-3 bg-zinc-900 text-white rounded-xl font-bold">Войти</a>
                    </div>
                <% } %>
            </form>
        </div>
    </div>
</section>

<script>
    const amountIn = document.getElementById('custom-amount');
    const previewAmount = document.getElementById('preview-amount');
    const previewRecipient = document.getElementById('preview-recipient');
    const inEmail = document.getElementById('in-email');
    const certPreview = document.getElementById('cert-preview');

    function setAmount(val) {
        amountIn.value = val;
        updatePreview();
    }

    function updatePreview() {
        previewAmount.innerText = Number(amountIn.value).toLocaleString('ru-RU');
        previewRecipient.innerText = inEmail.value || 'Счастливчик';
    }

    amountIn.addEventListener('input', updatePreview);
    inEmail.addEventListener('input', updatePreview);

    function changeCertTheme(theme) {
        certPreview.className = 'aspect-[1.6/1] rounded-[3rem] p-12 text-white relative overflow-hidden shadow-2xl transition-all duration-700';
        if (theme === 'zinc') certPreview.classList.add('bg-zinc-900');
        if (theme === 'emerald') certPreview.classList.add('bg-emerald-600');
        if (theme === 'blue') certPreview.classList.add('bg-blue-600');
    }
</script>

<%- include('footer') %>

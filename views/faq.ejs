<%- include('header') %>

<section class="max-w-4xl mx-auto px-4 py-24">
    <div class="text-center mb-16">
        <h1 class="text-5xl font-black text-zinc-900 tracking-tighter mb-4">Часто <span class="text-emerald-600">задаваемые</span> вопросы</h1>
        <p class="text-zinc-500">Найдите ответы на популярные вопросы или задайте свой онлайн</p>
    </div>

    <!-- FAQ Accordion -->
    <div class="space-y-4 mb-24">
        <% if (questions && questions.length > 0) { %>
            <% questions.forEach((q, index) => { %>
                <div class="glass rounded-3xl border border-zinc-100 overflow-hidden">
                    <button class="w-full p-8 text-left flex justify-between items-center hover:bg-zinc-50 transition-colors group" onclick="toggleFaq(<%= index %>)">
                        <span class="font-bold text-lg"><%= q.question %></span>
                        <i data-lucide="chevron-down" id="faq-icon-<%= index %>" class="w-5 h-5 text-zinc-400 group-hover:text-emerald-600 transition-transform"></i>
                    </button>
                    <div id="faq-content-<%= index %>" class="hidden animate-fade-in p-8 pt-0 border-t border-zinc-50 bg-zinc-50/50">
                        <p class="text-zinc-600 leading-relaxed"><%= q.answer %></p>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <div class="p-12 text-center bg-zinc-50 rounded-[3rem] border border-zinc-100 italic text-zinc-400">
                Пока ответов нет, но вы можете стать первым, кто задаст вопрос!
            </div>
        <% } %>
    </div>

    <!-- Ask Question Form -->
    <div class="glass p-12 rounded-[3.5rem] border border-emerald-100 shadow-2xl shadow-emerald-50">
        <h3 class="text-3xl font-bold mb-8 text-center">Задать свой <span class="text-emerald-600">вопрос</span></h3>
        
        <% if (success) { %>
            <div class="mb-8 p-6 bg-emerald-100 text-emerald-700 rounded-3xl font-bold flex items-center gap-4 animate-scale-in">
                <i data-lucide="check-circle" class="w-6 h-6"></i>
                <div>
                    Вопрос отправлен!
                    <p class="text-xs font-normal opacity-80">Администратор ответит вам в ближайшее время. Ответ появится здесь после модерации.</p>
                </div>
            </div>
        <% } %>

        <% if (user) { %>
            <form action="/faq/ask" method="POST" class="space-y-6">
                <div>
                    <label class="block text-xs font-bold uppercase text-zinc-500 mb-3 tracking-widest pl-2">Текст вопроса</label>
                    <textarea name="question" required rows="4" class="w-full px-8 py-6 bg-white border border-zinc-200 rounded-[2rem] outline-none ring-1 ring-zinc-100 focus:ring-emerald-500 transition-all resize-none shadow-sm" placeholder="Что вы хотели бы узнать?"></textarea>
                </div>
                <button type="submit" class="w-full py-5 bg-emerald-600 text-white rounded-[2rem] font-bold text-lg hover:bg-emerald-700 transition-all shadow-xl shadow-emerald-100 scale-100 active:scale-95">
                    Отправить вопрос
                </button>
                <div class="text-center">
                    <p class="text-[10px] text-zinc-400 uppercase tracking-widest leading-relaxed">Нажимая кнопку, вы подтверждаете согласие на обработку персональных данных</p>
                </div>
            </form>
        <% } else { %>
            <div class="text-center py-8">
                <p class="text-zinc-500 mb-6">Чтобы задать вопрос, пожалуйста, войдите в свой профиль.</p>
                <a href="/login" class="inline-block px-10 py-4 bg-zinc-900 text-white rounded-2xl font-bold hover:bg-zinc-800 transition-all">Войти</a>
            </div>
        <% } %>
    </div>
</section>

<script>
    function toggleFaq(id) {
        const content = document.getElementById(`faq-content-${id}`);
        const icon = document.getElementById(`faq-icon-${id}`);
        
        if (content.classList.contains('hidden')) {
            content.classList.remove('hidden');
            icon.style.transform = 'rotate(180deg)';
        } else {
            content.classList.add('hidden');
            icon.style.transform = 'rotate(0deg)';
        }
    }
</script>

<%- include('footer') %>

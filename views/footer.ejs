    <script>
        function initIcons() {
            if (typeof lucide !== 'undefined') {
                lucide.createIcons();
            } else {
                console.warn('Lucide is not loaded yet');
            }
        }

        window.addEventListener('DOMContentLoaded', initIcons);
        window.addEventListener('load', initIcons);

        // Scroll Top
        (function() {
            const btn = document.getElementById('scroll-top');
            if (btn) {
                window.addEventListener('scroll', () => {
                    if (window.scrollY > 300) {
                        btn.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-4');
                    } else {
                        btn.classList.add('opacity-0', 'pointer-events-none', 'translate-y-4');
                    }
                });

                btn.addEventListener('click', () => {
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                });
            }
        })();

        // Weather update from server-side data
        function updateWeather() {
            const tempEl = document.getElementById('weather-temp');
            const humEl = document.getElementById('weather-hum');
            const pressEl = document.getElementById('weather-press');
            const iconMain = document.getElementById('weather-icon-main');
            
            <% if (typeof weather !== 'undefined' && weather) { %>
                if (tempEl) tempEl.innerText = `<%= weather.temp > 0 ? '+' : '' %><%= weather.temp %>°C`;
                if (humEl) humEl.innerText = `<%= weather.humidity %>`;
                if (pressEl) pressEl.innerText = `<%= weather.pressure %>`;
                if (iconMain) {
                   const iconName = "<%= weather.conditions === 'rain' ? 'cloud-rain' : (weather.conditions === 'cloudy' ? 'cloud' : 'sun') %>";
                   iconMain.setAttribute('data-lucide', iconName);
                   if (typeof lucide !== 'undefined') lucide.createIcons();
                }
            <% } %>
        }
        updateWeather();
    </script>

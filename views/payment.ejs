<%- include('header') %>

<section class="py-20 max-w-2xl mx-auto px-4">
    <div class="glass p-12 rounded-3xl shadow-2xl text-center">
        <div class="w-16 h-16 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mx-auto mb-6">
            <i data-lucide="credit-card" class="w-8 h-8"></i>
        </div>
        <h1 class="text-3xl font-bold mb-4">Оплата бронирования</h1>
        <p class="text-zinc-500 mb-8">Вы оплачиваете услугу: <span class="font-bold text-zinc-900"><%= booking.service_name %></span></p>
        
        <div class="bg-zinc-50 rounded-2xl p-6 mb-8 text-left">
            <div class="flex justify-between items-center mb-4 pb-4 border-b border-zinc-200">
                <span class="text-zinc-500">К оплате</span>
                <span class="text-2xl font-bold"><%= booking.total_price %> ₽</span>
            </div>
            <div class="space-y-4">
                <div class="flex gap-4 items-center p-4 bg-white border border-zinc-200 rounded-xl cursor-pointer ring-2 ring-emerald-500">
                    <i data-lucide="wallet" class="text-zinc-400"></i>
                    <div class="text-left">
                        <div class="font-bold text-sm">Универсальный шлюз (ЮKassa / Card)</div>
                        <div class="text-[10px] text-zinc-400 uppercase">Мгновенное подтверждение</div>
                    </div>
                    <i data-lucide="check-circle" class="ml-auto text-emerald-500"></i>
                </div>
            </div>
        </div>

        <form action="<%= booking.is_event ? '/payment/event/process' : '/payment/process' %>" method="POST" class="space-y-8">
            <input type="hidden" name="booking_id" value="<%= booking.id %>">
            
            <% if (locals.error) { %>
                <div class="p-4 bg-red-50 border border-red-200 text-red-600 rounded-2xl text-sm animate-shake text-left">
                    <i data-lucide="alert-circle" class="inline w-4 h-4 mr-1"></i>
                    <%= error %>
                </div>
            <% } %>

            <!-- Points and Certificate Section -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 p-6 bg-zinc-100 rounded-3xl border border-zinc-200">
                <div class="text-left">
                    <label class="block text-[10px] font-bold uppercase text-zinc-500 mb-2">Списать баллы (у вас <%= user.points %>)</label>
                    <div class="relative">
                        <i data-lucide="zap" class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-amber-500"></i>
                        <input type="number" name="points_to_spend" min="0" max="<%= Math.min(user.points, Math.floor(booking.total_price * 0.5)) %>" 
                            class="w-full pl-12 pr-4 py-3 bg-white rounded-xl outline-none ring-1 ring-zinc-200 focus:ring-emerald-500 transition-all text-sm" 
                            placeholder="Макс. <%= Math.min(user.points, Math.floor(booking.total_price * 0.5)) %>">
                    </div>
                    <p class="text-[9px] text-zinc-400 mt-2 italic">Можно оплатить до 50% суммы</p>
                </div>
                <div class="text-left">
                    <label class="block text-[10px] font-bold uppercase text-zinc-500 mb-2">Код сертификата</label>
                    <div class="relative">
                        <i data-lucide="ticket" class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-emerald-500"></i>
                        <input type="text" name="cert_code" 
                            class="w-full pl-12 pr-4 py-3 bg-white rounded-xl outline-none ring-1 ring-zinc-200 focus:ring-emerald-500 transition-all text-sm font-mono" 
                            placeholder="CERT-XXXX">
                    </div>
                </div>
            </div>

            <button type="submit" class="w-full py-5 bg-emerald-600 text-white rounded-2xl font-bold text-lg hover:bg-emerald-700 transition-all shadow-xl shadow-emerald-200 flex items-center justify-center gap-3">
                <i data-lucide="check-circle-2"></i>
                <%= booking.is_event ? 'Купить билеты' : 'Оплатить сейчас' %>
            </button>
        </form>
        
        <p class="mt-6 text-xs text-zinc-400">Нажимая на кнопку, вы соглашаетесь с условиями оферты и политикой конфиденциальности.</p>
    </div>
</section>

<%- include('footer') %>

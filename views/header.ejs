        </div>
        <div class="text-left relative z-10">
            <div id="weather-temp" class="text-lg font-black text-zinc-800 tracking-tight leading-none mb-1">Загрузка...</div>
            <div class="text-[9px] font-bold text-zinc-400 uppercase tracking-widest leading-none flex flex-col gap-1">

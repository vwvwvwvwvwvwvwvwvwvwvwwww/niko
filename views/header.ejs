    <!-- Notifications Container -->
    <div id="toast-container" class="fixed top-4 right-4 z-[100] flex flex-col gap-3 pointer-events-none"></div>

    <script>
        function showToast(message, type = 'success') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            const bgClass = type === 'success' ? 'bg-emerald-600' : 'bg-red-600';
            const icon = type === 'success' ? 'check-circle' : 'alert-circle';
            
            toast.className = `${bgClass} text-white px-6 py-4 rounded-2xl shadow-2xl flex items-center gap-3 animate-fade-in pointer-events-auto transform transition-all translate-x-12 opacity-0 hover:scale-105 cursor-pointer min-w-[280px]`;
            toast.innerHTML = `
                <i data-lucide="${icon}" class="w-5 h-5 flex-shrink-0"></i>
                <div class="flex-1 text-sm font-bold">${message}</div>
                <button class="ml-2 hover:bg-white/20 p-1 rounded-full"><i data-lucide="x" class="w-4 h-4"></i></button>
            `;
            
            container.appendChild(toast);
            if (window.lucide) lucide.createIcons();
            
            // Re-render to trigger animation
            setTimeout(() => {
                toast.classList.remove('translate-x-12', 'opacity-0');
            }, 10);

            const removeToast = () => {
                toast.classList.add('translate-x-12', 'opacity-0');
                setTimeout(() => toast.remove(), 300);
            };

            toast.onclick = removeToast;
            setTimeout(removeToast, 5000);
        }

        // Check for URL messages
        window.addEventListener('DOMContentLoaded', () => {
            const urlParams = new URLSearchParams(window.location.search);
            const success = urlParams.get('success');
            const error = urlParams.get('error');
            
            const messages = {
                'booked': 'Бронирование успешно создано!',
                'paid': 'Оплата успешно принята!',
                'cancelled': 'Бронирование отменено.',
                'review_added': 'Спасибо за отзыв!',
                'cert_purchased': 'Сертификат успешно приобретен!',
                'updated': 'Профиль обновлен.',
                'sent': 'Сообщение отправлено!',
                'asked': 'Вопрос задан.',
                'event_paid': 'Билеты оплачены!'
            };

            if (success && messages[success]) showToast(messages[success], 'success');
            if (error) showToast(error, 'error');
        });
    </script>


        </div>

        <!-- Scroll Top -->
        <button id="scroll-top" class="w-12 h-12 bg-zinc-200/80 backdrop-blur-sm text-zinc-400 rounded-full shadow-lg flex items-center justify-center hover:bg-zinc-300 transition-all opacity-0 pointer-events-none translate-y-4 hover:scale-105 active:scale-95">
            <i data-lucide="arrow-up" class="w-5 h-5"></i>
        </button>
    </div>

    <script type="module">
        const chatToggle = document.getElementById('chat-toggle');
        const chatBox = document.getElementById('chat-box');
        const chatClose = document.getElementById('chat-close');
        const chatInput = document.getElementById('chat-input');
        const chatSend = document.getElementById('chat-send');
        const chatMessages = document.getElementById('chat-messages');

        let chatHistory = [];
        let isFetching = false;

        function addMessage(text, role = 'ai', animate = true) {
            const div = document.createElement('div');
            const isUser = role === 'user';
            const isAi = role === 'ai';
            const isAdmin = role === 'admin';

            div.className = isUser 
                ? "bg-zinc-200 p-3 rounded-2xl rounded-tr-none max-w-[85%] ml-auto text-zinc-800"
                : (isAdmin ? "bg-emerald-600 text-white p-3 rounded-2xl rounded-tl-none max-w-[85%]" : "bg-emerald-100 p-3 rounded-2xl rounded-tl-none max-w-[85%] text-emerald-900");
            
            if (isAdmin) {
                div.innerHTML = `<div class="text-[8px] font-black uppercase opacity-70 mb-1">Сотрудник Нико</div>${text}`;
            } else {
                div.textContent = text;
            }

            chatMessages.appendChild(div);
            chatMessages.scrollTop = chatMessages.scrollHeight;
            
            // Sync history for Gemini
            chatHistory.push({
                role: isUser ? "user" : "model",
                parts: [{ text }]
            });
        }

        async function loadHistory() {
            try {
                const res = await fetch('/api/chat/history');
                if (res.ok) {
                    const messages = await res.json();
                    if (messages.length > 0) {
                        chatMessages.innerHTML = '';
                        chatHistory = [];
                        messages.forEach(msg => {
                            addMessage(msg.content, msg.sender_role, false);
                        });
                    }
                }
            } catch (e) {}
        }

        chatToggle.addEventListener('click', () => {
            chatBox.classList.toggle('hidden');
            if (!chatBox.classList.contains('hidden')) {
                loadHistory();
            }
        });

        chatClose.addEventListener('click', () => chatBox.classList.add('hidden'));

        async function sendMessage() {
            const text = chatInput.value.trim();
            if (!text || isFetching) return;

            addMessage(text, 'user');
            chatInput.value = '';
            
            try {
                const res = await fetch('/api/chat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message: text })
                });
                
                if (res.ok) {
                    await loadHistory();
                }
            } catch (error) {
                console.error('Chat error:', error);
            }
        }

        chatSend.addEventListener('click', sendMessage);
        chatInput.addEventListener('keypress', (e) => {
            if (e.key === 'Enter') sendMessage();
        });

        // Poll history if chat is open to get admin replies
        setInterval(() => {
            if (!chatBox.classList.contains('hidden') && !isFetching) {
                // We could implement a more efficient fetch only for new messages
                loadHistory();
            }
        }, 4000);
    </script>


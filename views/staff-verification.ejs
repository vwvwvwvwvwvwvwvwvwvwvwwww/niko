<%- include('header') %>

<section class="py-20 max-w-2xl mx-auto px-4">
    <div class="glass p-12 rounded-[3rem] shadow-2xl border border-zinc-100 animate-scale-in">
        <div class="w-20 h-20 bg-emerald-100 text-emerald-600 rounded-[2rem] flex items-center justify-center mx-auto mb-8 shadow-lg shadow-emerald-50">
            <i data-lucide="check-circle-2" class="w-10 h-10"></i>
        </div>
        
        <h1 class="text-3xl font-black text-center mb-2">Бронирование подтверждено</h1>
        <p class="text-zinc-500 text-center mb-12">Данные клиента проверены успешно</p>

        <div class="space-y-8">
            <!-- Client Info -->
            <div class="bg-zinc-50 p-8 rounded-[2rem] border border-zinc-100">
                <div class="text-[10px] uppercase font-bold text-zinc-400 tracking-widest mb-4">Информация о клиенте</div>
                <div class="flex items-center gap-4 mb-6">
                    <div class="w-12 h-12 bg-zinc-900 text-white rounded-full flex items-center justify-center font-bold text-xl">
                        <%= booking.user_name[0] %>
                    </div>
                    <div>
                        <div class="font-bold text-lg"><%= booking.user_name %></div>
                        <div class="text-sm text-zinc-500"><%= booking.user_email %></div>
                        <div class="text-[10px] font-bold text-emerald-600 uppercase mt-1"><%= booking.user_role %></div>
                    </div>
                </div>
            </div>

            <!-- Booking Info -->
            <div class="bg-white p-8 rounded-[2rem] border-2 border-zinc-50 shadow-sm">
                <div class="text-[10px] uppercase font-bold text-zinc-400 tracking-widest mb-6">Детали заказа #<%= booking.id %></div>
                
                <div class="grid grid-cols-2 gap-8">
                    <div>
                        <div class="text-[10px] uppercase font-bold text-zinc-400 mb-1">Услуга</div>
                        <div class="font-bold text-emerald-600"><%= booking.service_name %></div>
                    </div>
                    <div>
                        <div class="text-[10px] uppercase font-bold text-zinc-400 mb-1">Кол-во гостей</div>
                        <div class="font-bold"><%= booking.guests %> чел.</div>
                    </div>
                    <div>
                        <div class="text-[10px] uppercase font-bold text-zinc-400 mb-1">Дата</div>
                        <div class="font-bold"><%= new Date(booking.booking_date).toLocaleDateString('ru-RU') %></div>
                    </div>
                    <div>
                        <div class="text-[10px] uppercase font-bold text-zinc-400 mb-1">Стоимость</div>
                        <div class="font-bold text-zinc-900"><%= booking.total_price %> ₽</div>
                    </div>
                </div>

                <div class="mt-8 pt-6 border-t border-zinc-50">
                    <div class="flex justify-between items-center">
                        <span class="text-[10px] uppercase font-bold text-zinc-400">Статус оплаты</span>
                        <span class="<%= booking.is_paid ? 'text-emerald-600' : 'text-amber-600' %> font-black text-xs uppercase tracking-widest flex items-center gap-1">
                            <i data-lucide="<%= booking.is_paid ? 'check-circle' : 'alert-circle' %>" class="w-3 h-3"></i>
                            <%= booking.is_paid ? 'Оплачено' : 'К оплате' %>
                        </span>
                    </div>
                </div>
            </div>

            <% if (booking.wishes) { %>
                <div class="p-6 bg-amber-50 border border-amber-100 rounded-2xl">
                    <div class="text-[10px] uppercase font-bold text-amber-600 mb-2">Пожелания клиента</div>
                    <p class="text-sm text-amber-900">"<%= booking.wishes %>"</p>
                </div>
            <% } %>

            <div class="flex gap-4">
                <a href="/staff" class="flex-1 py-5 bg-zinc-900 text-white rounded-2xl font-bold text-center hover:bg-zinc-800 transition-all shadow-xl shadow-zinc-200">
                    На панель управления
                </a>
            </div>
        </div>
    </div>
</section>

<%- include('footer') %>

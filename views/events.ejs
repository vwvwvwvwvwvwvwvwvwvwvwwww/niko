<%- include('header') %>

<section class="py-20 max-w-7xl mx-auto px-4">
    <div class="flex flex-col md:flex-row justify-between items-end gap-8 mb-16">
        <div class="max-w-2xl">
            <h1 class="text-6xl font-bold mb-6 tracking-tight">Афиша <span class="text-emerald-600">мероприятий</span></h1>
            <p class="text-lg text-zinc-500">Участвуйте в наших турах, концертах и спортивных событиях. Бронируйте билеты заранее!</p>
        </div>
        <% if (locals.query && locals.query.error === 'sold_out') { %>
            <div class="bg-red-50 text-red-600 px-6 py-4 rounded-2xl border border-red-100 flex items-center gap-3">
                <i data-lucide="alert-circle"></i> К сожалению, билеты закончились
            </div>
        <% } %>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
        <% events.forEach(event => { %>
            <div class="glass group rounded-[2.5rem] overflow-hidden border border-zinc-100 shadow-xl hover:shadow-2xl transition-all duration-500">
                <div class="h-64 overflow-hidden relative">
                    <img src="<%= optImg(event.image_url, 600) %>" loading="lazy" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700">
                    <div class="absolute top-6 left-6 px-4 py-2 bg-white/90 backdrop-blur rounded-full text-xs font-black uppercase tracking-widest text-zinc-900 shadow-lg">
                        <%= new Date(event.event_date).toLocaleDateString('ru-RU', { day: 'numeric', month: 'long' }) %>
                    </div>
                </div>
                <div class="p-10">
                    <div class="flex justify-between items-start mb-4">
                        <h3 class="text-2xl font-bold"><%= event.title %></h3>
                        <div class="text-emerald-600 font-bold text-xl"><%= event.price %> ₽</div>
                    </div>
                    <p class="text-zinc-500 text-sm mb-8 leading-relaxed"><%= event.description %></p>
                    
                    <div class="flex items-center justify-between mb-8">
                        <div class="text-[10px] font-bold uppercase text-zinc-400">Свободно мест</div>
                        <div class="flex items-center gap-3">
                            <div class="w-24 h-2 bg-zinc-100 rounded-full overflow-hidden">
                                <div class="h-full bg-emerald-500 rounded-full" style="width: <%= (event.tickets_sold / event.capacity) * 100 %>%"></div>
                            </div>
                            <div class="text-xs font-bold text-zinc-900"><%= event.capacity - event.tickets_sold %> / <%= event.capacity %></div>
                        </div>
                    </div>

                    <form action="/events/book" method="POST" class="flex gap-3">
                        <input type="hidden" name="event_id" value="<%= event.id %>">
                        <input type="number" name="tickets" value="1" min="1" max="10" class="w-20 px-4 py-4 bg-zinc-50 rounded-2xl outline-none ring-1 ring-zinc-200 focus:ring-emerald-500">
                        <button type="submit" class="flex-1 py-4 bg-emerald-600 text-white rounded-2xl font-bold hover:bg-emerald-700 transition-all shadow-lg shadow-emerald-100">
                            Купить билеты
                        </button>
                    </form>
                </div>
            </div>
        <% }) %>
    </div>

    <!-- Suggested Services -->
    <div class="mt-32 pt-20 border-t border-zinc-100">
        <div class="text-center mb-16">
            <h2 class="text-4xl font-bold mb-4">Наши <span class="text-indigo-600">постоянные</span> услуги</h2>
            <p class="text-zinc-500">Дополните свой отдых классическими развлечениями Нико</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
            <div class="glass p-8 rounded-3xl group hover:border-emerald-500 transition-all">
                <i data-lucide="zap" class="w-10 h-10 text-emerald-600 mb-4"></i>
                <h4 class="font-bold mb-2 text-lg">Квадроциклы</h4>
                <p class="text-xs text-zinc-500 mb-6">Драйв и адреналин по лесным тропам.</p>
                <a href="/booking?service=1" class="text-xs font-bold text-emerald-600 flex items-center gap-2 group-hover:gap-4 transition-all">
                    Забронировать <i data-lucide="arrow-right" class="w-3 h-3"></i>
                </a>
            </div>
            <div class="glass p-8 rounded-3xl group hover:border-indigo-500 transition-all">
                <i data-lucide="flame" class="w-10 h-10 text-indigo-600 mb-4"></i>
                <h4 class="font-bold mb-2 text-lg">Баня на дровах</h4>
                <p class="text-xs text-zinc-500 mb-6">Лучший релакс после активного дня.</p>
                <a href="/booking?service=5" class="text-xs font-bold text-indigo-600 flex items-center gap-2 group-hover:gap-4 transition-all">
                    Забронировать <i data-lucide="arrow-right" class="w-3 h-3"></i>
                </a>
            </div>
        </div>
    </div>
</section>

<%- include('footer') %>

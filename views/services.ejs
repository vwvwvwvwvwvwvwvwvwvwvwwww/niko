<%- include('header') %>

<section class="py-12 max-w-7xl mx-auto px-4">
    <div class="text-center mb-16">
        <h1 class="text-5xl font-bold tracking-tighter mb-4">Наши услуги</h1>
        <p class="text-zinc-500 max-w-2xl mx-auto">От экстремальных приключений до спокойного отдыха — у нас есть всё для вашего идеального отпуска.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
        <% services.forEach(service => { %>
            <div class="group bg-white rounded-3xl overflow-hidden shadow-sm hover:shadow-2xl transition-all duration-500 border border-zinc-100">
                <div class="h-72 overflow-hidden relative">
                    <img src="<%= optImg(service.image_url, 600) %>" alt="<%= service.name %>" loading="lazy" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700">
                    <div class="absolute top-4 right-4 bg-white/90 backdrop-blur px-4 py-2 rounded-full text-sm font-bold text-emerald-600 shadow-lg">
                        <%= service.price %> ₽
                    </div>
                </div>
                <div class="p-8">
                    <h3 class="text-2xl font-bold mb-4"><%= service.name %></h3>
                    <p class="text-zinc-500 text-sm mb-8 leading-relaxed"><%= service.description %></p>
                    <div class="flex items-center justify-between pt-6 border-t border-zinc-50">
                        <div class="flex items-center gap-2 text-xs text-zinc-400 font-bold uppercase tracking-widest">
                            <i data-lucide="clock" class="w-4 h-4"></i>
                            Ежедневно
                        </div>
                        <a href="/booking?service=<%= service.id %>" class="px-6 py-3 bg-emerald-600 text-white rounded-2xl text-sm font-bold hover:bg-emerald-700 transition-all shadow-lg shadow-emerald-100">Забронировать</a>
                    </div>
                </div>
            </div>
        <% }) %>
    </div>
</section>

<%- include('footer') %>

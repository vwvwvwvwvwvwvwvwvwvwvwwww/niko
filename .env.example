# Режим: development | production
NODE_ENV=production

# Порт сервера (хостинг часто задаёт PORT автоматически)
PORT=3000

# Публичный URL сайта (без слэша в конце), например https://niko-base.ru
APP_URL=https://example.com

# Секрет для подписи cookie-сессий (сгенерируйте длинную случайную строку)
SESSION_SECRET=замените-на-случайную-строку-минимум-32-символа

# Путь к файлу SQLite (по умолчанию: niko.db в корне проекта)
# DATABASE_PATH=./data/niko.db

# sameSite для cookie: lax (обычный сайт) | none (встраивание в iframe)
# COOKIE_SAME_SITE=lax

# Gemini API (опционально, для AI-функций)
GEMINI_API_KEY=

# Email-уведомления (SMTP)
# Письма уходят на любую почту гостя: Gmail, Mail.ru, Yandex, Outlook и т.д.
# Достаточно SMTP_USER + SMTP_PASS — хост подберётся по домену почты

# Провайдер (опционально): yandex | gmail | mailru | outlook | rambler | icloud | yahoo
# SMTP_PROVIDER=gmail

SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=your@gmail.com
SMTP_PASS=пароль-приложения
SMTP_FROM="База отдыха НИКО <your@gmail.com>"
SMTP_REPLY_TO=booking@niko-base.ru

# Один или несколько адресов администратора через запятую
ADMIN_EMAIL=admin@niko.ru,booking@niko-base.ru

# SMS (опционально)
SMS_API_KEY=

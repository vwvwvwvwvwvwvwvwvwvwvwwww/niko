# Режим: development | production
NODE_ENV=production

# Порт сервера (хостинг часто задаёт PORT автоматически)
PORT=3000

# Публичный URL сайта (без слэша в конце), например https://niko-base.ru
APP_URL=https://example.com

# Секрет для подписи cookie-сессий (сгенерируйте длинную случайную строку)
SESSION_SECRET=замените-на-случайную-строку-минимум-32-символа

# Путь к файлу SQLite (по умолчанию: niko.db в корне проекта)
# DATABASE_PATH=./data/niko.db

# sameSite для cookie: lax (обычный сайт) | none (встраивание в iframe)
# COOKIE_SAME_SITE=lax

# Gemini API (опционально, для AI-функций)
GEMINI_API_KEY=

# Telegram-уведомления (опционально)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# SMS (опционально)
SMS_API_KEY=
